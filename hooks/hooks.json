{
  "description": "relay bash guard: blocks secret-leaking and exit-code-swallowing shell habits",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_guard.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
